MONGO_URI=mongodb://localhost:27017/expendifii
PORT=5000
# Required — the server refuses to start without this.
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminPassword
NODE_ENV=development
# Optional in dev, comma-separated allowlist (e.g. https://app.example.com,https://admin.example.com).
# Leave unset to allow all origins — logs a warning when NODE_ENV=production or on Vercel.
CORS_ORIGIN=
# Required when deployed on Vercel or with NODE_ENV=production — authenticates
# requests to /internal/cron/daily-stats (Vercel signs its cron requests with
# this as a Bearer token; see vercel.json). Optional for local dev only.
CRON_SECRET=