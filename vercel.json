{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/daily-stats",
      "schedule": "0 2 * * *"
    }
  ]
}